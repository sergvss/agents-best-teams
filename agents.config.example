# ============================================================
# agents.config — конфигурация PRIMARY и SIDE-моделей проекта
# ============================================================
# Скопируй этот файл в корень своего проекта как `agents.config` и заполни.
#
# Этот файл КОММИТИТСЯ — в нём нет секретов. API-ключи лежат в .env
# и подключаются через `api_key_env` (имя переменной окружения).
#
# Терминология PRIMARY / SIDE-A / SIDE-B — см. principles/01-philosophy.md
# Триангуляция — principles/05-triangulated-review.md
# Бюджет — principles/04-orchestration-budgets.md
# ============================================================

# ------------------------------------------------------------
# [primary] — твой главный агент в IDE/CLI
# ------------------------------------------------------------
# Этот агент:
#  - живёт в твоём IDE (Claude Code / Cursor / Codex / Cline / Aider / ...)
#  - знает инварианты проекта (через CLAUDE.md / .cursor/rules / system prompt)
#  - имеет persistent memory (см. principles/06-memory-hygiene.md)
#  - выполняет основную работу — план, код, ревью с контекстом

[primary]
platform     = "claude-code"        # claude-code | cursor | codex | cline | aider | other
vendor       = "anthropic"          # ВАЖНО: задаётся явно для проверки независимости от SIDE-моделей.
                                    # openai | google | anthropic | xai | mistral | ...
                                    # Даже если модель управляется IDE, vendor нужен для правила
                                    # PRIMARY.vendor ≠ SIDE-A.vendor ≠ SIDE-B.vendor.
model        = "claude-opus-5"      # подсказка, для отчётов; фактически модель управляется платформой
memory_dir   = ".claude/agent-memory"   # путь к persistent memory; для Cursor — ".cursor/agent-memory" и т.п.

# ------------------------------------------------------------
# Различение vendor и gateway
# ------------------------------------------------------------
# vendor   — компания, обучившая модель (OpenAI, Google, Anthropic, xAI, Mistral, ...)
# gateway  — через какой API ты её дёргаешь (OpenRouter, прямой API провайдера, ...)
#
# Правило независимости (см. principles/05-triangulated-review.md) применяется
# к VENDOR, не к gateway: PRIMARY.vendor ≠ SIDE-A.vendor ≠ SIDE-B.vendor.
# OpenRouter как gateway для обеих SIDE — допустимо; OpenAI как vendor для обеих
# SIDE — НЕ допустимо.

# ------------------------------------------------------------
# [side_a] — первый внешний ревьюер
# ------------------------------------------------------------
# КАК ВЫБИРАТЬ МОДЕЛЬ: по измеримому порогу, а не по названию тира.
#
# Порог для ревью — coding_index >= 74 (Artificial Analysis; виден в каталоге
# OpenRouter). Для точек высокого риска (прод-биллинг, прод-RBAC, DDL прода) —
# coding_index >= 77 и reasoning effort = high.
#
# Почему порог, а не тир: названия тиров перестали означать уровень. На август
# 2026 модель Google с "flash" в имени (coding 76.1) обходит вчерашний флагман
# OpenAI (coding 74.9) и стоит в 13 раз дешевле. Ориентироваться на слова
# "mini" / "flash" / "pro" в слаге больше нельзя — только на индекс.
#
# Проверить актуальные значения самому:
#   каталог OpenRouter → сортировка "coding-high-to-low" → колонка coding_index
#
# Подробности и обоснование — principles/04-orchestration-budgets.md,
# раздел «Выбор модели для ревью».

[side_a]
vendor       = "openai"              # openai | google | anthropic | xai | mistral | ...
gateway      = "openrouter"          # openrouter | openai | google | anthropic | direct
model        = "openai/gpt-5.6-sol"  # coding 77.4, $2/$10 за M токенов. Проходит порог высокого риска.
effort       = "high"                # low | medium | high | xhigh | max — вторая ручка цены наравне с моделью.
                                     # Значение здесь — дефолт для Tier-3. На Tier-2 агент вправе
                                     # опустить до "medium": принцип — экономить effort'ом, а не
                                     # моделью ниже порога. Таблица по типам прогона — principles/04.
api_key_env  = "OPENROUTER_API_KEY"
base_url     = "https://openrouter.ai/api/v1"
max_tokens   = 6000
timeout_s    = 90

# ------------------------------------------------------------
# [side_b] — второй внешний ревьюер
# ------------------------------------------------------------
# vendor должен отличаться И от primary, И от side_a (см. правило выше).

[side_b]
vendor       = "google"
gateway      = "openrouter"
model        = "google/gemini-3.7-flash"   # coding 76.1, $0.375/$1.875 за M токенов.
                                           # Проходит порог ревью при цене на порядок ниже SIDE-A —
                                           # наглядный пример, почему тир по имени больше не работает.
effort       = "high"
api_key_env  = "OPENROUTER_API_KEY"
base_url     = "https://openrouter.ai/api/v1"
max_tokens   = 6000
timeout_s    = 90

# ------------------------------------------------------------
# Альтернативные составы тройки — раскомментируй для смены конфигурации
# ------------------------------------------------------------
# Дата последней сверки с каталогом моделей. Читается CI, который
# предупреждает, когда она старше трёх месяцев. Обнови при переоценке.
# models_reviewed: 2026-08-25
#
# Значения coding_index — на 25 августа 2026. Переоценивай раз в квартал:
# каталог протухает, правило порога — нет.
#
# Дефолтная тройка (PRIMARY = Claude в Claude Code):
#   PRIMARY = anthropic (claude-opus-5 платформой, coding 78.0)
#   SIDE-A  = openai    (openai/gpt-5.6-sol, coding 77.4)
#   SIDE-B  = google    (google/gemini-3.7-flash, coding 76.1)
#
# Если PRIMARY = GPT (Codex/Copilot Workspace):
#   SIDE-A = anthropic  (anthropic/claude-opus-5, coding 78.0)
#   SIDE-B = google     (google/gemini-3.7-flash, coding 76.1)
#
# Если PRIMARY = Gemini (Cursor/Cline с Gemini):
#   SIDE-A = anthropic  (anthropic/claude-opus-5, coding 78.0)
#   SIDE-B = openai     (openai/gpt-5.6-sol, coding 77.4)
#
# Бюджетный режим (частые Tier-2 на стабильной кодовой базе):
#   SIDE-A vendor = "xai"   model = "x-ai/grok-4.6"           # coding 76.8, $2/$6
#   SIDE-B vendor = "google" model = "google/gemini-3.7-flash" # coding 76.1, $0.375/$1.875
#   ⚠ Меняя модель, меняй и vendor — правило независимости проверяется по нему.
#   Оба выше порога 74 — экономия здесь не покупается качеством ревью.
#   Экономить правильнее через effort = "medium", а не через модель ниже порога.
#
# ⚠ Ниже порога 74 не опускаться на ревью ни в каком режиме: модель отвечает
#   пустым approve и ревью превращается в ритуал (эмпирика — principles/04).

# ------------------------------------------------------------
# [budget] — лимиты на платные API-вызовы SIDE-моделей
# ------------------------------------------------------------
# Подробности и логика проверки — principles/04-orchestration-budgets.md
# Все значения в USD. Реальная стоимость зависит от выбранных моделей.

[budget]
per_review_usd = 0.50      # одна триангуляция diff'а (PRIMARY + SIDE-A + SIDE-B)
per_tier3_usd  = 2.00      # полный Tier-3 цикл (план + триангуляция + 1-2 итерации)
monthly_usd    = 50.00     # общий месячный потолок на SIDE-вызовы (hard limit)

# Раздельные политики overflow — разные пороги имеют разную семантику.
# per_review / per_tier3 — soft (можно спросить и продолжить).
# monthly — hard (только block или ask_user; "warn" недопустим, см. principles/04).
on_review_overflow  = "ask_user"   # ask_user | block | warn  — для per_review_usd и per_tier3_usd
on_monthly_overflow = "ask_user"   # ask_user | block         — для monthly_usd (warn запрещён)
                                   # ask_user — спросить пользователя при превышении
                                   # block    — заблокировать вызов, эскалировать
                                   # warn     — продолжить, но залогировать предупреждение
                                   #            (только для on_review_overflow!)

# Файл, где агент хранит накопленный ledger расходов за текущий месяц.
# Это локальный state, не общий ресурс — обязательно добавь в .gitignore.
# Путь — на твой выбор; типовые варианты:
#   .agent-state/budget-ledger.json   ← локально в проекте
#   ~/.config/agents/budget-ledger.json   ← глобально в home
ledger_file = ".agent-state/budget-ledger.json"

# ------------------------------------------------------------
# [triangulation] — настройки правила 2-из-3
# ------------------------------------------------------------

[triangulation]
# Минимум согласных ревьюеров, чтобы пометить замечание как блокер.
consensus_threshold = 2

# Запускать ли SIDE-B автоматически на Tier 2 (security/RBAC/миграции).
# По дефолту — нет: на Tier 2 хватает PRIMARY + SIDE-A.
side_b_on_tier2 = false

# Размер diff'а в строках, выше которого требуется явное подтверждение
# (большие diff'ы → большая стоимость).
diff_size_warn_lines = 1500

# ------------------------------------------------------------
# [escalation] — кому эскалируем при блокерах
# ------------------------------------------------------------

[escalation]
owner_handle = "@your-handle"      # GitHub username / Slack handle владельца проекта
notify_on    = ["budget_overflow", "consensus_blocker", "side_provider_down"]
