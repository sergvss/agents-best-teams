{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py",
              "--rules",
              "fs,git,sql,env,memory"
            ],
            "timeout": 10,
            "statusMessage": "Проверка команды защитными хуками"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py",
              "--rules",
              "env,memory"
            ],
            "timeout": 10,
            "statusMessage": "Проверка пути защитными хуками"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/approval_log.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
